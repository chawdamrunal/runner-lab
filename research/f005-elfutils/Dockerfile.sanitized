FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN sed -i 's/^Types: deb$/Types: deb deb-src/' \
      /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install --no-install-recommends -y \
       build-essential \
       ca-certificates \
       dpkg-dev \
       libdw-dev=0.190-1.1ubuntu0.1 \
       libelf-dev=0.190-1.1ubuntu0.1 \
    && apt-get build-dep -y elfutils=0.190-1.1ubuntu0.1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

RUN apt-get source elfutils=0.190-1.1ubuntu0.1 \
    && cd /build/elfutils-0.190 \
    && CFLAGS='-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer -D_FORTIFY_SOURCE=0' \
       LDFLAGS='-fsanitize=address,undefined' \
       ./configure --disable-debuginfod --disable-libdebuginfod \
    && make -j2 \
    && dpkg-parsechangelog -S Version \
       > /usr/local/share/f005-elfutils-source-version.txt

COPY f005_libdwfl_replay.c /src/f005_libdwfl_replay.c

RUN gcc -O1 -g -Wall -Wextra -Werror \
      -fsanitize=address,undefined \
      -fno-omit-frame-pointer \
      -o /usr/local/bin/f005-libdwfl-replay-sanitized \
      /src/f005_libdwfl_replay.c \
      -ldw -lelf

ENV LD_LIBRARY_PATH="/build/elfutils-0.190/libdw/.libs:/build/elfutils-0.190/libelf/.libs"
ENV ASAN_OPTIONS="abort_on_error=1:disable_coredump=1:detect_leaks=0"
ENV UBSAN_OPTIONS="halt_on_error=1:print_stacktrace=1"

ENTRYPOINT ["/usr/local/bin/f005-libdwfl-replay-sanitized"]
